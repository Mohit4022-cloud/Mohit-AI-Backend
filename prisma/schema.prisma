// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User and Authentication
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  password        String
  role            UserRole  @default(SDR)
  isActive        Boolean   @default(true)
  emailVerified   Boolean   @default(false)
  
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  
  leads           Lead[]    @relation("AssignedLeads")
  activities      Activity[]
  calls           Call[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Organization {
  id              String    @id @default(cuid())
  name            String
  domain          String?   @unique
  plan            PlanType  @default(STARTER)
  isActive        Boolean   @default(true)
  
  // Settings
  responseTimeSeconds Int   @default(60)
  enableVoiceCalls   Boolean @default(true)
  enableSMS          Boolean @default(true)
  enableEmail        Boolean @default(true)
  enableLiveChat     Boolean @default(true)
  
  // AI Settings
  enableAICalls     Boolean   @default(true)
  enableAITranscription Boolean @default(true)
  enableAIInsights  Boolean   @default(true)
  maxConcurrentAICalls Int @default(3)
  
  users           User[]
  leads           Lead[]
  integrations    Integration[]
  webhooks        Webhook[]
  
  // AI Relations
  aiCallQueue     AICallQueue[]
  contentCards    ContentCard[]
  aiSettings      AISettings?
  progressiveSettings ProgressiveSettings?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Lead Management
model Lead {
  id              String    @id @default(cuid())
  
  // Contact Information
  firstName       String?
  lastName        String?
  email           String?
  phone           String?
  company         String?
  jobTitle        String?
  
  // Lead Details
  source          String
  sourceDetails   Json?
  status          LeadStatus @default(NEW)
  score           Int       @default(0)
  qualificationData Json?
  
  // Assignment
  assignedToId    String?
  assignedTo      User?     @relation("AssignedLeads", fields: [assignedToId], references: [id])
  
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  
  activities      Activity[]
  calls           Call[]
  conversations   Conversation[]
  
  // AI Relations
  aiCallQueue     AICallQueue[]
  
  // Timestamps
  firstContactAt  DateTime?
  lastContactAt   DateTime?
  qualifiedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([organizationId])
}

// Activity Tracking
model Activity {
  id              String    @id @default(cuid())
  type            ActivityType
  description     String?
  data            Json?
  
  leadId          String
  lead            Lead      @relation(fields: [leadId], references: [id])
  
  userId          String?
  user            User?     @relation(fields: [userId], references: [id])
  
  createdAt       DateTime  @default(now())
  
  @@index([leadId])
  @@index([type])
}

// Call Management
model Call {
  id              String    @id @default(cuid())
  twilioCallSid   String?   @unique
  direction       CallDirection
  status          CallStatus
  duration        Int?      // in seconds
  recordingUrl    String?
  transcription   String?
  
  from            String
  to              String
  
  leadId          String
  lead            Lead      @relation(fields: [leadId], references: [id])
  
  userId          String?
  user            User?     @relation(fields: [userId], references: [id])
  
  // AI Call Features
  mode            CallMode  @default(AI)
  agentStatus     AgentStatus @default(IDLE)
  aiAgentId       String?
  aiSettings      Json?
  
  // AI Analysis
  sentiment       Int?      // 0-100 sentiment score
  summary         String?
  qualificationScore Int?
  nextSteps       String[]
  keywords        String[]
  
  // Call Queue
  queuePriority   QueuePriority @default(MEDIUM)
  queuePosition   Int?
  scheduledAt     DateTime?
  
  // Advanced Features
  isAiEnabled     Boolean   @default(true)
  isTranscribing  Boolean   @default(true)
  isRecording     Boolean   @default(true)
  transcriptMode  TranscriptMode @default(SIDEBAR)
  
  startedAt       DateTime?
  answeredAt      DateTime?
  endedAt         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  transcriptEntries TranscriptEntry[]
  aiInsights      AIInsight[]
  contentCards    ContentCard[]
  aiCallMetrics   AICallMetrics?
  
  @@index([twilioCallSid])
  @@index([leadId])
  @@index([status])
  @@index([mode])
  @@index([queuePriority])
}

// Conversation History
model Conversation {
  id              String    @id @default(cuid())
  channel         Channel
  messages        Message[]
  
  leadId          String
  lead            Lead      @relation(fields: [leadId], references: [id])
  
  status          ConversationStatus @default(ACTIVE)
  summary         String?
  
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  updatedAt       DateTime  @updatedAt
}

model Message {
  id              String    @id @default(cuid())
  role            MessageRole
  content         String
  metadata        Json?
  
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id])
  
  createdAt       DateTime  @default(now())
}

// CRM Integrations
model Integration {
  id              String    @id @default(cuid())
  type            IntegrationType
  isActive        Boolean   @default(true)
  config          Json      // Encrypted credentials and settings
  lastSyncAt      DateTime?
  
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Webhooks
model Webhook {
  id              String    @id @default(cuid())
  url             String
  events          String[]  // Array of event types
  isActive        Boolean   @default(true)
  secret          String    // For webhook signature validation
  
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Enums
enum UserRole {
  ADMIN
  MANAGER
  SDR
  VIEWER
}

enum PlanType {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFYING
  QUALIFIED
  UNQUALIFIED
  NURTURE
  CLOSED_WON
  CLOSED_LOST
}

enum ActivityType {
  INBOUND_RECEIVED
  CALL_INITIATED
  CALL_COMPLETED
  SMS_SENT
  EMAIL_SENT
  CHAT_INITIATED
  QUALIFICATION_COMPLETED
  STATUS_CHANGED
  NOTE_ADDED
  TASK_CREATED
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallStatus {
  QUEUED
  RINGING
  IN_PROGRESS
  COMPLETED
  FAILED
  BUSY
  NO_ANSWER
  CANCELED
}

enum Channel {
  VOICE
  SMS
  EMAIL
  CHAT
  LINKEDIN
}

enum ConversationStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum MessageRole {
  SYSTEM
  ASSISTANT
  USER
}

enum IntegrationType {
  HUBSPOT
  SALESFORCE
  PIPEDRIVE
  MONDAY
  ZOHO
  CUSTOM
}

// AI Call Models

// AI Call Queue
model AICallQueue {
  id              String    @id @default(cuid())
  leadId          String
  lead            Lead      @relation(fields: [leadId], references: [id])
  
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  
  priority        QueuePriority @default(MEDIUM)
  status          QueueStatus @default(PENDING)
  scheduledAt     DateTime?
  attempts        Int       @default(0)
  maxAttempts     Int       @default(3)
  lastAttemptAt   DateTime?
  
  settings        Json?
  metadata        Json?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([organizationId])
  @@index([leadId])
  @@index([priority])
  @@index([status])
  @@index([scheduledAt])
}

// Transcript Entry
model TranscriptEntry {
  id              String    @id @default(cuid())
  callId          String
  call            Call      @relation(fields: [callId], references: [id])
  
  speaker         TranscriptSpeaker
  text            String
  timestamp       DateTime
  duration        Int?      // in milliseconds
  
  // AI Analysis
  sentiment       Int?      // 0-100
  confidence      Float?    // 0-1
  keywords        String[]
  
  metadata        Json?
  
  createdAt       DateTime  @default(now())
  
  @@index([callId])
  @@index([speaker])
  @@index([timestamp])
}

// AI Insight
model AIInsight {
  id              String    @id @default(cuid())
  callId          String
  call            Call      @relation(fields: [callId], references: [id])
  
  type            InsightType
  title           String
  content         String
  confidence      Int       // 0-100
  priority        InsightPriority @default(MEDIUM)
  
  // Context
  keywords        String[]
  context         Json?
  
  // Status
  status          InsightStatus @default(ACTIVE)
  dismissedAt     DateTime?
  dismissedBy     String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([callId])
  @@index([type])
  @@index([priority])
  @@index([status])
}

// Content Card
model ContentCard {
  id              String    @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  
  callId          String?
  call            Call?     @relation(fields: [callId], references: [id])
  
  type            ContentCardType
  title           String
  content         String
  priority        ContentCardPriority @default(MEDIUM)
  
  // Display settings
  isActive        Boolean   @default(true)
  isDismissible   Boolean   @default(true)
  displayDuration Int?      // in seconds
  
  // Actions
  actionButtons   Json?
  metadata        Json?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([organizationId])
  @@index([callId])
  @@index([type])
  @@index([priority])
  @@index([isActive])
}

// AI Call Metrics
model AICallMetrics {
  id              String    @id @default(cuid())
  callId          String    @unique
  call            Call      @relation(fields: [callId], references: [id])
  
  // Performance metrics
  responseTime    Int?      // in seconds
  firstResponseTime Int?    // in seconds
  avgResponseTime Float?    // in seconds
  
  // AI metrics
  aiSpeakingTime  Int?      // in seconds
  humanSpeakingTime Int?    // in seconds
  silenceTime     Int?      // in seconds
  interruptions   Int       @default(0)
  
  // Quality metrics
  sentimentScore  Float?    // 0-1
  engagementScore Float?    // 0-1
  clarityScore    Float?    // 0-1
  
  // Topic analysis
  topics          Json?
  keywords        String[]
  
  // Technical metrics
  connectionQuality Int?    // 0-100
  transcriptionAccuracy Float? // 0-1
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// AI Settings
model AISettings {
  id              String    @id @default(cuid())
  organizationId  String    @unique
  organization    Organization @relation(fields: [organizationId], references: [id])
  
  // Voice settings
  voiceId         String?
  modelId         String?
  language        String    @default("en")
  voiceSettings   Json?
  
  // AI behavior
  responseSpeed   Int       @default(5) // 1-10
  formalityLevel  Int       @default(5) // 1-10
  empathyLevel    Int       @default(5) // 1-10
  technicalDetail Int       @default(5) // 1-10
  
  // Features
  enableRecording Boolean   @default(true)
  enableTranscription Boolean @default(true)
  enableInsights  Boolean   @default(true)
  enableRealTimeAnalysis Boolean @default(true)
  
  // Privacy & Compliance
  recordAnnouncement Boolean @default(true)
  aiDisclosure    Boolean   @default(true)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Progressive Settings
model ProgressiveSettings {
  id              String    @id @default(cuid())
  organizationId  String    @unique
  organization    Organization @relation(fields: [organizationId], references: [id])
  
  level           ProgressiveLevel @default(OVERVIEW)
  features        Json?
  preferences     Json?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// New Enums for AI Features

enum CallMode {
  AI
  HUMAN
  HYBRID
}

enum AgentStatus {
  LISTENING
  PROCESSING
  SPEAKING
  IDLE
}

enum QueuePriority {
  HIGH
  MEDIUM
  LOW
}

enum QueueStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum TranscriptSpeaker {
  AI
  LEAD
  AGENT
  SYSTEM
}

enum InsightType {
  SENTIMENT
  TOPIC
  COMPETITOR
  PRICING
  ACTION
  OBJECTION
  QUESTION
}

enum InsightPriority {
  HIGH
  MEDIUM
  LOW
}

enum InsightStatus {
  ACTIVE
  DISMISSED
  RESOLVED
}

enum ContentCardType {
  PRICING
  COMPETITOR
  OBJECTION
  INSIGHT
  TALKING_POINT
  FAQ
  FEATURE
}

enum ContentCardPriority {
  HIGH
  MEDIUM
  LOW
}

enum TranscriptMode {
  SIDEBAR
  SUBTITLE
  DISABLED
}

enum ProgressiveLevel {
  OVERVIEW
  BASIC
  DETAILED
  ADVANCED
}