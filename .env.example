# Server Configuration
NODE_ENV=development
PORT=5000
BASE_URL=http://localhost:5000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/mohit_ai

# Authentication
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# Twilio Configuration
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your_api_key_secret

# AI Configuration
AI_PROVIDER=openai
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=150

# ElevenLabs Configuration
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_AGENT_ID=your_agent_id
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=ulaw_8000
ELEVENLABS_OPTIMIZE_STREAMING_LATENCY=3
ELEVENLABS_VOICE_SETTINGS={"stability":0.5,"similarity_boost":0.75,"style":0.0,"use_speaker_boost":true}

# n8n Configuration
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/
N8N_API_KEY=your_n8n_api_key

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SENDGRID_API_KEY=your_sendgrid_api_key

# CRM Integrations
HUBSPOT_API_KEY=your_hubspot_api_key
SALESFORCE_CLIENT_ID=your_salesforce_client_id
SALESFORCE_CLIENT_SECRET=your_salesforce_client_secret
PIPEDRIVE_API_KEY=your_pipedrive_api_key

# AI Services
OPENAI_API_KEY=your_openai_api_key
GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_api_key

# AI Calls Configuration
ENABLE_AI_CALLS=true
ENABLE_AI_TRANSCRIPTION=true
ENABLE_AI_INSIGHTS=true
MAX_CONCURRENT_AI_CALLS=3
AI_CALLS_PER_MINUTE=10
AI_CALLS_PER_HOUR=100
AI_CALLS_PER_DAY=1000

# AI Transcription Configuration
TRANSCRIPTION_PROVIDER=openai
TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_LANGUAGE=en
ENABLE_REAL_TIME_TRANSCRIPTION=true

# AI Analytics Configuration
ENABLE_AI_ANALYTICS=true
ENABLE_SENTIMENT_ANALYSIS=true
ENABLE_KEYWORD_DETECTION=true
ENABLE_COMPETITOR_TRACKING=true

# AI Content Cards Configuration
ENABLE_CONTENT_CARDS=true
CONTENT_CARD_CACHE_TTL=300
MAX_CONTENT_CARDS_PER_CALL=10

# Progressive Settings Configuration
DEFAULT_PROGRESSIVE_LEVEL=OVERVIEW
ENABLE_ADVANCED_FEATURES=false

# AI Compliance & Privacy
REQUIRE_AI_DISCLOSURE=true
REQUIRE_RECORDING_ANNOUNCEMENT=true
ENABLE_CALL_ANONYMIZATION=false
TRANSCRIPT_RETENTION_DAYS=90
VOICE_DATA_RETENTION_DAYS=30

# AI Performance Configuration
AI_RESPONSE_TIMEOUT=10000
AI_MAX_RETRIES=3
AI_BATCH_PROCESSING_SIZE=10
AI_CONCURRENT_REQUESTS=5

# AI Cache Configuration (Redis)
AI_CACHE_TTL=300
AI_INSIGHTS_CACHE_TTL=600
AI_ANALYTICS_CACHE_TTL=900

# AI Webhooks
AI_WEBHOOK_SECRET=your-ai-webhook-secret
AI_WEBHOOK_TIMEOUT=5000
AI_WEBHOOK_EVENTS=call.started,call.ended,insight.generated,queue.updated

# Stripe (for billing)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Monitoring
SENTRY_DSN=https://xxxxxxxx@sentry.io/xxxxxxx

# Feature Flags
ENABLE_VOICE_CALLS=true
ENABLE_SMS=true
ENABLE_EMAIL=true
ENABLE_LIVE_CHAT=true
RESPONSE_TIME_SECONDS=60

# WebSocket Configuration
WEBSOCKET_PORT=3001
WEBSOCKET_PATH=/socket.io/

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001